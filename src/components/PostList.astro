---
import type { Post } from '../utils';
import { formatDate, isoDate, readingStats, slugifyTag } from '../utils';

interface Props { posts: Post[] }
const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p class="empty">No posts yet. The first one is on its way.</p>
) : (
  <ol class="posts">
    {posts.map((post) => {
      const { minutes } = readingStats(post.body);
      return (
        <li>
          <p class="meta"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time></p>
          <div class="body">
            <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a>{post.data.draft && <span class="draft">draft</span>}</h3>
            <p class="desc">{post.data.description}</p>
            <div class="foot">
              <span class="meta">{minutes} min read</span>
              {post.data.tags.map((t) => <a class="tag" href={`/tags/${slugifyTag(t)}/`}>{t}</a>)}
            </div>
          </div>
        </li>
      );
    })}
  </ol>
)}

<style>
  .posts { list-style: none; margin: 0; padding: 0; display: grid; }
  .posts > li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .posts > li:last-child { border-bottom: 1px solid var(--line); }
  .posts p { margin: 0; }
  .meta { padding-top: 0.2rem; }
  .body { display: grid; gap: 0.4rem; max-width: var(--measure); }
  h3 { font-size: var(--step-1); }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--mustard); }
  .desc { color: var(--muted); }
  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .foot .meta { padding: 0; margin-right: 0.25rem; }
  .draft { margin-left: 0.5rem; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 400; text-transform: uppercase; letter-spacing: 0.08em; border: 1px solid currentColor; padding: 0 0.3rem; border-radius: 3px; vertical-align: middle; }
  .empty { color: var(--muted); }
  @media (max-width: 36rem) { .posts > li { grid-template-columns: 1fr; gap: 0.3rem; } }
</style>
