---
import Base from '../layouts/Base.astro';
import { AUTHOR } from '../site.config';

const links = [
  { label: 'LinkedIn', href: AUTHOR.links.linkedin },
  { label: 'Personal website', href: AUTHOR.links.website },
];
---

<Base title="About" description={`About ${AUTHOR.name}, ${AUTHOR.role}.`}>
  <section class="band">
    <div class="frame about">
      <p class="kicker">About</p>
      <h1>{AUTHOR.name}</h1>
      <p class="role">{AUTHOR.role}</p>
      <ul class="links">
        {links.map((l) => (
          <li><a class="btn" href={l.href} target="_blank" rel="me noopener">{l.label} ↗</a></li>
        ))}
      </ul>
    </div>
  </section>

  <div class="frame content">
    <div class="text">
      <section aria-labelledby="bio">
        <h2 id="bio">Hi, I'm {AUTHOR.name.split(' ')[0]}</h2>
        {AUTHOR.bio.map((p) => <p>{p}</p>)}
      </section>
      <section aria-labelledby="why">
        <h2 id="why">Why this blog</h2>
        <p>{AUTHOR.why}</p>
      </section>
    </div>
    <aside class="focus" aria-labelledby="focus">
      <h2 id="focus">What I work on</h2>
      <ul>
        {AUTHOR.focus.map((f) => (
          <li><h3>{f.title}</h3><p>{f.text}</p></li>
        ))}
      </ul>
    </aside>
  </div>
</Base>

<style>
  .about { padding-block: clamp(2.75rem, 7vw, 4.5rem); display: grid; gap: 0.8rem; }
  .about p { margin: 0; }
  h1 { font-size: var(--step-4); letter-spacing: -0.03em; }
  .role { font-size: var(--step-1); opacity: 0.9; }
  .links { list-style: none; margin: 0.8rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .content {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem;
    padding-top: clamp(2.5rem, 6vw, 3.5rem);
    align-items: start;
  }
  .text { display: grid; gap: 2.25rem; max-width: var(--measure); }
  .text section { display: grid; gap: 0.9rem; }
  .text h2 { font-size: var(--step-2); }
  .text p { margin: 0; font-size: 1.08rem; }

  .focus { background: var(--paper); border: 1px solid var(--line); border-top: 4px solid var(--mustard); border-radius: var(--radius); padding: 1.4rem 1.5rem; display: grid; gap: 1rem; }
  .focus h2 { font-size: var(--step-1); }
  .focus ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .focus li { display: grid; gap: 0.2rem; }
  .focus li + li { padding-top: 1rem; border-top: 1px solid var(--line); }
  .focus h3 { font-size: 1rem; }
  .focus p { margin: 0; color: var(--muted); font-size: 0.95rem; line-height: 1.55; }

  @media (max-width: 52rem) { .content { grid-template-columns: 1fr; gap: 2.25rem; } }
</style>
