---
import Base from '../layouts/Base.astro';
import { AUTHOR } from '../site.config';

const links = [
  { label: 'LinkedIn', href: AUTHOR.links.linkedin, note: 'Work history and how to reach me' },
  { label: 'Personal website', href: AUTHOR.links.website, note: 'Everything else about me' },
  { label: 'GitHub', href: AUTHOR.links.github, note: 'Code, including the source for this blog' },
];
---

<Base title="About" description={`About ${AUTHOR.name}, ${AUTHOR.role}.`}>
  <section class="frame about">
    <p class="label">About</p>
    <h1>{AUTHOR.name}</h1>
    <p class="role">{AUTHOR.role}</p>
    <div class="prose">
      {AUTHOR.bio.map((p) => <p>{p}</p>)}
    </div>

    <h2>Find me elsewhere</h2>
    <ul class="links">
      {links.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="me noopener">
            <span class="name">{l.label} ↗</span>
            <span class="note">{l.note}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .about { padding-block: clamp(2.5rem, 7vw, 4.5rem); display: grid; gap: 1rem; }
  .about > p { margin: 0; }
  h1 { font-size: var(--step-4); letter-spacing: -0.03em; }
  .role { font-family: var(--font-display); font-size: var(--step-1); color: var(--muted); }
  h2 { font-size: var(--step-2); margin-top: 2rem; }
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; max-width: var(--measure); }
  .links a {
    display: grid;
    gap: 0.15rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
  }
  .links a:hover { border-color: var(--accent); }
  .name { font-family: var(--font-display); font-weight: 700; color: var(--ink); }
  .note { color: var(--muted); font-size: 0.95rem; }
</style>
