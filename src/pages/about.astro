---
import Base from '../layouts/Base.astro';
import { AUTHOR } from '../site.config';

const links = [
  { label: 'LinkedIn', href: AUTHOR.links.linkedin },
  { label: 'Personal website', href: AUTHOR.links.website },
];
---

<Base title="About" description={`About ${AUTHOR.name}, ${AUTHOR.role}.`}>
  <section class="frame about">
    <p class="label">About</p>
    <h1>{AUTHOR.name}</h1>
    <p class="role">{AUTHOR.role}</p>
    <ul class="links">
      {links.map((l) => (
        <li><a href={l.href} target="_blank" rel="me noopener">{l.label} ↗</a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .about { padding-block: clamp(2.5rem, 7vw, 4.5rem); display: grid; gap: 1rem; }
  .about > p { margin: 0; }
  h1 { font-size: var(--step-4); letter-spacing: -0.03em; }
  .role { font-family: var(--font-display); font-size: var(--step-1); color: var(--muted); }
  .links { list-style: none; margin: 1rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .links a {
    display: inline-block;
    padding: 0.7rem 1.15rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 500;
    text-decoration: none;
  }
  .links a:hover { border-color: var(--accent); }
</style>
