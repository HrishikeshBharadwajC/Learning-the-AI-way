---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, slugifyTag } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag: slugifyTag(tag) },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<Base title={tag} description={`Posts tagged ${tag}.`}>
  <section class="band">
    <div class="frame top">
      <p class="kicker"><a href="/blog/">Writing</a> / Tag</p>
      <h1>{tag}</h1>
    </div>
  </section>
  <section class="frame list">
    <PostList posts={posts} />
  </section>
</Base>

<style>
  .top { padding-block: clamp(2.25rem, 6vw, 3.5rem); display: grid; gap: 0.75rem; }
  .top p { margin: 0; }
  .kicker a { color: inherit; }
  h1 { font-size: var(--step-3); }
  .list { padding-top: 2rem; }
</style>
